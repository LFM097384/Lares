<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- 图标下面显示的名字。这里是回落值(系统语言既非中文也非英文时用),
	     实际显示由 en.lproj / zh-Hans.lproj 的 InfoPlist.strings 覆盖:
	       en      → Lares Circle
	       zh-Hans → 炉灵
	     App Store 上的名字是 ASC 里单独填的(Lares Circle),与这里无关 ——
	     单独的「Lares」已被 Ksenia 的安防产品占用。 -->
	<key>CFBundleDisplayName</key>
	<string>Lares Circle</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lares</string>
			</array>
			<key>CFBundleURLName</key>
			<string>com.lfm097384.lares.deeplink</string>
		</dict>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>进圈后需要麦克风才能和圈友说话</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>开启位置共享后,圈内朋友能在地图上看到你的位置(关闭即停止)</string>
	<!-- ⚠️ 本 App **不使用相机**,但这条是必填的。
	     libwebrtc(flutter_webrtc 带进来的)静态引用了相机 API,
	     Apple 的静态扫描只看符号、不看是否真的调用。
	     缺了它 → ITMS-90683,构建被判 FAILED。

	     2026-09-19 踩过一次,而且极难定位:altool 报 "No errors uploading"、
	     有 delivery-uuid、32MB 确实传到了 Apple,但构建**从不出现**在
	     TestFlight,也没有任何邮件。原因只有在 REST API 的
	     `GET /v1/buildUploads/<id>` 的 `state.errors` 里才看得到。
	     altool **不上报处理阶段的错误**,这是它和 REST 通道的关键差别。

	     文案如实说明「不用相机」—— 审核员会读这些字符串,
	     写一个假用途反而是风险。 -->
	<key>NSCameraUsageDescription</key>
	<string>本应用不使用相机。这条说明是底层音视频库(WebRTC)的固定要求,即使只做语音通话也必须声明。</string>
	<!-- 同上,也是 libwebrtc / geolocator 的静态引用带来的。
	     这一条在 90683 里只是 warning 不是 error,但补上没有坏处:
	     真到了某次 Apple 收紧扫描,它会变成 error。
	     我们只在前台共享位置,文案如实写明。 -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>开启位置共享后,圈内朋友能在地图上看到你的位置。本应用只在你打开 App 时共享,不在后台持续定位。</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- 局域网开发联调:允许本地网络走明文 ws://(公网部署用 wss,不受影响) -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- ══ 出口加密合规:这里**刻意不写** ITSAppUsesNonExemptEncryption ══

	     不是漏了。三种取值都试过,只有「不写」能过:

	     · false —— 语义是「豁免、无需申报」,只适用于仅 HTTPS/TLS 或
	       仅用 Apple 系统加密的 App。本 App 有自己实现的 E2EE
	       (LiveKit sharedKey,底层 AES)和 Argon2id 密钥派生,不适用。

	     · true  —— 2026-09-19 实测被 altool 预检拒绝:
	       ITMS-90592 Invalid Export Compliance Code,
	       "the export compliance key value [] ... doesn't match"。
	       因为 true 会让 Apple 继续索要 ITSEncryptionExportComplianceCode,
	       而那个编号只发给上传过 CCATS 文档的 App。我们走自分类
	       (5D992.c / ENC 740.17(b)(1)),按规定就不需要 CCATS,
	       自然没有编号,值为空 → 校验失败。

	     · 不写   —— 每次上传后由 App Store Connect 网页问卷来问。
	       这正是自分类应走的路径。

	     ASC 问卷怎么答(答案固定,见 docs/app-store/submission-kit.md §6):
	       使用加密?            是
	       仅用 Apple 系统加密?  否(带了 libwebrtc 和 hashlib)
	       算法是否自研?        否,均为标准算法
	       属于豁免类别?        是 —— 5D992.c,Mass Market

	     ⚠️ 分类结论没有变,变的只是**在哪里申报**。我们仍然是 5D992.c,
	     上架即构成出口,须在**次年 2 月 1 日前**把年度自分类报告(CSV)
	     发到 crypt-supp8@bis.doc.gov 与 enc@nsa.gov。
	     完整依据与 CSV 字段见 docs/compliance/encryption-export.md

	     另一个易错点(BIS 明确堵死):不能因为 LiveKit / hashlib 是开源库
	     就主张「公开可得、不受 EAR 管辖」。并入开源加密代码会构成一个
	     具有加密功能的**新物项**,须作为整体重新评估。
	     https://www.bis.gov/learn-support/encryption-controls/encryption-items-not-subject-to-ear (Note 2)
	     ══════════════════════════════════════════════════════════════ -->
	<!-- 只保留 audio:常驻语音房在后台必须继续收发音频。
	     曾经还声明过 fetch,但全项目没有任何 BGTaskScheduler 实现 ——
	     声明了却不使用的后台模式是明确的拒绝理由(2.5.4)。 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>lares_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
