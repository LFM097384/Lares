<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- 图标下面显示的名字。这里是回落值(系统语言既非中文也非英文时用),
	     实际显示由 en.lproj / zh-Hans.lproj 的 InfoPlist.strings 覆盖:
	       en      → Lares Circle
	       zh-Hans → 炉灵
	     App Store 上的名字是 ASC 里单独填的(Lares Circle),与这里无关 ——
	     单独的「Lares」已被 Ksenia 的安防产品占用。 -->
	<key>CFBundleDisplayName</key>
	<string>Lares Circle</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lares</string>
			</array>
			<key>CFBundleURLName</key>
			<string>com.lfm097384.lares.deeplink</string>
		</dict>
	</array>
	<key>NSMicrophoneUsageDescription</key>
	<string>进圈后需要麦克风才能和圈友说话</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>开启位置共享后,圈内朋友能在地图上看到你的位置(关闭即停止)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- 局域网开发联调:允许本地网络走明文 ws://(公网部署用 wss,不受影响) -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- 出口加密合规声明(App Store Connect 每次上传都会问,写死在这里免得手答)。
	     ⚠️ 2026-09 修正:此前填 false,是错的。

	     本 App 用到的加密已超出「仅 TLS」的豁免范围:
	       · LiveKit E2EE(E2EEOptions.sharedKey(),底层 AES)
	       · Argon2id 由圈子口令派生 E2EE 共享密钥(hashlib)
	       · HMAC-SHA256 信令挑战应答
	       · TLS / DTLS-SRTP
	     其中 E2EE 与 Argon2id 是**我们自己实现的加密功能**,
	     不是系统或传输层顺带提供的。

	     旧注释「落在 Mass Market 5D992.c 内,所以填 false」自相矛盾:
	     5D992.c 走 License Exception ENC 740.17(b)(1),确实**不需要 CCATS**,
	     但**需要向 BIS 提交年度自分类报告**,而这条路要求本键填 true。
	     填 false 的语义是「豁免、无需任何申报」—— 那是给「仅 HTTPS」或
	     「仅用 Apple 系统加密」的 App 准备的。

	     另一个易错点(BIS 明确堵死):不能因为 LiveKit / hashlib 是开源库
	     就主张「公开可得、不受 EAR 管辖」。并入开源加密代码会构成一个
	     **具有加密功能的新物项**,须作为整体重新评估。
	     https://www.bis.gov/learn-support/encryption-controls/encryption-items-not-subject-to-ear (Note 2)

	     ⏰ 随之而来的义务:某自然年内有出口(上架即是),须在**次年 2 月 1 日前**
	     把年度自分类报告(CSV)发到 crypt-supp8@bis.doc.gov 与 enc@nsa.gov。
	     细节见 docs/compliance/encryption-export.md -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
	<!-- 只保留 audio:常驻语音房在后台必须继续收发音频。
	     曾经还声明过 fetch,但全项目没有任何 BGTaskScheduler 实现 ——
	     声明了却不使用的后台模式是明确的拒绝理由(2.5.4)。 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>lares_app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
