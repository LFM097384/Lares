# Node
node_modules/
npm-debug.log

# Flutter/Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
# app/pubspec.lock 刻意**不**忽略(2026-09 改)。
# Flutter 官方对「应用」的建议就是提交 lock 文件;先前忽略它意味着
# CI 每次 pub get 都可能解析到不同版本。这不是理论风险 ——
# path_provider_foundation 从 2.5.1 漂到 2.6.0 会让 iOS 上传产出
# 结构无效的 ipa(flutter#187752),而报错要到 altool 阶段才出现。
# 锁住版本,让本地跑通的组合等于 CI 跑的组合。
*.iml
.idea/

# 环境与密钥(绝不提交 LiveKit 凭据)
.env
*.local

# OS
Thumbs.db
.DS_Store

# 运行时数据与日志
*.log
server/data/
server/tool/node_modules/

# LiveKit 开发用二进制(部署走官方镜像/下载,不入库)
server/livekit/

# Flutter 插件链接(Junction,指向本机 pub 缓存)
**/.plugin_symlinks/

# 本地下载的构建产物
dist/

# 临时缓存
.tmp-npm-cache/

# 部署运行时状态(VPS 上的端口基线/回滚快照,机器相关,不入库)
deploy/.state/

# 音频捕获验证工具的产物(WAV/日志,体积大且机器相关)
app/spike_out/
app/tool/capture_out/
