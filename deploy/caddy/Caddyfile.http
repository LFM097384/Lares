# ──────────────────────────────────────────────────────────────────────────────
# LARES_TLS_MODE=http —— 独占 80/443 的机器用这个,最省事
#
# 适用前提:**这台机器上没有别的东西在用 80 和 443**。
#   Lares 专用 VPS 就属于这种。
#   如果机器上还跑着机场(xray Reality 占 443),**绝对不能用这个模式** ——
#   Caddy 会去抢 443,机场当场失联。那种情况用 LARES_TLS_MODE=dns。
#
# 与 dns 模式的取舍:
#   · http 模式:不需要 DNS API token,不需要自建带插件的镜像,
#               官方 caddy:2-alpine 直接能用。代价是必须独占 80/443。
#   · dns  模式:不碰任何入站端口,但要 Cloudflare token + 自建镜像。
#
# 证书自动签发、自动续期,Caddy 全包。什么都不用管。
# ──────────────────────────────────────────────────────────────────────────────
{
	# 证书到期提醒邮箱(留空则不注册邮箱)
	email {$LARES_ACME_EMAIL}

	# ACME 目录。.env 里的 LARES_ACME_CA 控制,默认走正式环境。
	#
	# **强烈建议首次部署先用 staging**:
	#   LARES_ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
	#
	# staging 的限额宽得多,用来验证「端口通不通、解析对不对、Caddy 配置有没有错」
	# 正合适。跑通了再删掉这行换正式的。
	#
	# ⚠️ 用 *.cloudapp.azure.com 这类 Azure 免费域名时**尤其要先走 staging**:
	#    该后缀**不在**公共后缀列表里(已核对 publicsuffix.org),
	#    所以 Let's Encrypt 把它的注册域算作 azure.com ——
	#    50 张/周的配额是**和全世界共享的**,可能直接签不下来。
	#    先用 staging 确认链路无误,再去抢正式配额,别把失败次数浪费在配置错误上。
	acme_ca {$LARES_ACME_CA}
}

# 先引入共用路由片段,再定义站点(片段必须先于使用处出现)
import routes.caddyfile

# 标准 443。写成裸域名(不带端口)时 Caddy 自动开启 HTTPS 与 HTTP→HTTPS 跳转。
{$LARES_DOMAIN} {
	import lares_routes
}
