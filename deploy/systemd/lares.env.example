# systemd EnvironmentFile —— 安装到 /etc/lares/lares.env 并 chmod 600
#
# ⚠️ 格式与 docker 的 .env 不同:
#    · 不做变量展开,${VAR} 不会被解析
#    · 值不要加引号(systemd 会把引号当字面量的一部分)
#    · 一行一个 KEY=VALUE

# ── 服务 ──────────────────────────────────────────────────────────────────
LARES_PORT=8787
LARES_DATA_DIR=/var/lib/lares

# ── LiveKit ───────────────────────────────────────────────────────────────
# 必须带端口(除非用 LiveKit Cloud 的标准 443)
LIVEKIT_URL=wss://rtc.example.com:8444
LIVEKIT_API_KEY=change-me-key
LIVEKIT_API_SECRET=change-me-secret
# 服务端调 LiveKit 管理 API(把被驱逐的人移出媒体房)用的地址;留空则用 LIVEKIT_URL
LIVEKIT_API_URL=http://127.0.0.1:7880

# ── 鉴权:公网部署绝不能填 none ───────────────────────────────────────────
# none | token | circle | token,circle
LARES_AUTH_MODE=circle
LARES_AUTH_TOKEN=
LARES_CIRCLE_PASSCODE=
# JSON 对象,注意不要加外层引号:
# LARES_CIRCLE_PASSCODES={"home":"口令A","work":"口令B"}
LARES_CIRCLE_PASSCODES=
LARES_ALLOWED_ORIGIN=
LARES_AUTH_NONCE_TTL_MS=60000

# ── 客户端自建圈 ───────────────────────────────────────────────────────────
# 每 IP 每小时最多注册几个圈(0 = 关闭自助注册)
LARES_CIRCLE_CREATE_PER_HOUR=5
# 全站注册圈总量上限
LARES_MAX_CIRCLES=500
# 真实 IP:auto = 对端是回环/内网(反代)时取 X-Forwarded-For 最右一项;1 = 总是信;0 = 从不信
LARES_TRUST_PROXY=auto
