# ══════════════════════════════════════════════════════════════════════════════
# Lares 炉灵 — 部署配置模板
#
#   cp .env.example .env && vim .env
#
# 标记说明:
#   【必填】  不填就起不来(compose 用 ${VAR:?} 强制,会直接报错拒绝启动)
#   【建议】  有默认值,但你多半想改
#   【可选】  默认值通常够用
#
# ⚠️ .env 里全是密钥,已在 .gitignore 中。**永远不要提交**。
#    建议:chmod 600 .env
#
# ⚠️ 这台 VPS 同时在跑机场(xray / 3x-ui)。以下端口**已被占用,禁止使用**:
#      443/tcp   VLESS+Reality 主入站(伪装 www.apple.com)
#      8443/tcp  第二 Reality 入站
#      3443/udp  Hysteria2
#      9721/tcp  3x-ui 面板
#      2096/tcp  订阅端点
#      22/tcp    SSH(fail2ban 保护中)
#    改任何端口前,先跑 ./preflight.sh 确认不冲突。
# ══════════════════════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────────────────────────
# 1. 域名与 TLS
# ──────────────────────────────────────────────────────────────────────────────

# 【必填】域名。DNS A 记录指向本 VPS。
#   还没买域名?→ 填服务器公网 IP,并把下面 LARES_TLS_MODE 设为 selfsigned。
#     ⚠️ 自签模式下浏览器和 iOS 会拒绝连接,只能用桌面端冒烟测试。
LARES_DOMAIN=rtc.example.com

# 【建议】对外 HTTPS 端口。**绝对不能填 443**(那是机场的命根子)。
#   浏览器、Flutter(含 Web)对 wss://host:8444 这种非标端口支持完全正常,
#   只是 URL 里必须显式带上端口号。
LARES_HTTPS_PORT=8444

# 【必填】TLS 模式,三选一 —— 这是切换证书方案的**唯一开关**:
#
#   dns        ← 默认推荐。DNS-01 签发,**零入站端口**,绝不碰 80/443。
#                需要:带 Cloudflare 插件的自建镜像 + CLOUDFLARE_API_TOKEN
#                (cd caddy && ./build-caddy.sh)
#
#   file       自备证书(acme.sh / certbot / 云厂商都行),不跑 ACME。
#                需要:LARES_CERT_DIR 指向证书目录。到期要自己续。
#
#   selfsigned ⚠️ 不安全,仅供买域名前冒烟测试。浏览器/iOS 会拒绝。
#                Caddy 内置 CA 的叶子证书默认只有 12 小时有效期。
#
# ⚠️ 为什么不能用 HTTP-01?
#    经核对 Caddy 源码:站点即使写成「域名:8444」,Caddy 依然会尝试
#    TLS-ALPN-01(去用 :443)和 HTTP-01(去用 :80)—— 443 正是机场的端口。
#    只有 DNS-01 会关闭其它 challenge。所以 dns 是这台机器上唯一安全的自动签发方式。
LARES_TLS_MODE=dns

# 【dns 模式必填】Cloudflare API Token
#   创建:Cloudflare 控制台 → My Profile → API Tokens → Create Token
#   权限:Zone.Zone:Read + Zone.DNS:Edit,Zone Resources 限定到你这一个域名
#   (用 Token,不要用 Global API Key —— 后者权限过大)
CLOUDFLARE_API_TOKEN=

# 【dns 模式必填】带 DNS 插件的 Caddy 镜像
#   官方 caddy:2-alpine **不含**任何 DNS provider,DNS-01 会失败。
#   构建:cd caddy && ./build-caddy.sh
#   file / selfsigned 模式则填 caddy:2-alpine 即可。
LARES_CADDY_IMAGE=lares-caddy:dns

# 【可选】证书到期提醒邮箱(留空则不注册)
LARES_ACME_EMAIL=

# 【file 模式必填】宿主机证书目录,需含 fullchain.pem 与 privkey.pem
LARES_CERT_DIR=./certs
LARES_CERT_FILE=/certs/fullchain.pem
LARES_KEY_FILE=/certs/privkey.pem


# ──────────────────────────────────────────────────────────────────────────────
# 2. LiveKit 凭据与地址
# ──────────────────────────────────────────────────────────────────────────────

# 【必填】生成命令:
#   LIVEKIT_API_KEY:    openssl rand -hex 16
#   LIVEKIT_API_SECRET: openssl rand -hex 32     ← secret 至少 32 字符
LIVEKIT_API_KEY=change-me-key
LIVEKIT_API_SECRET=change-me-secret

# 【必填】下发给客户端的 LiveKit 地址。
#   ⚠️ 必须带上 LARES_HTTPS_PORT!不带端口客户端会去连 443 —— 那是机场,必然失败。
#   自托管:  wss://rtc.example.com:8444
#   LiveKit Cloud: wss://your-project.livekit.cloud   (Cloud 用标准 443,不写端口)
LIVEKIT_PUBLIC_URL=wss://rtc.example.com:8444


# ──────────────────────────────────────────────────────────────────────────────
# 3. 鉴权 —— 公网部署的生命线
# ──────────────────────────────────────────────────────────────────────────────

# 【必填】鉴权模式:none | token | circle | "token,circle"(任一通过即可)
#
#   ⚠️⚠️ 公网部署**绝对不要**填 none。
#        none 意味着任何扫到你端口的人都能连上信令、白嫖带宽、进你的圈子。
#        compose 用 ${LARES_AUTH_MODE:?} 强制此项必须显式赋值;
#        preflight.sh 也会在发现 none 时直接判定失败。
#
#   token  —— 全站共享密钥,适合「所有人一个口令」
#   circle —— 按圈子设口令,适合「不同圈子不同人」
LARES_AUTH_MODE=circle

# 【token 模式必填】生成:openssl rand -hex 32
LARES_AUTH_TOKEN=

# 【circle 模式必填(二选一)】
#   全站统一口令。生成:openssl rand -base64 12
LARES_CIRCLE_PASSCODE=
#   或按圈子分别设置(优先级高于上面那条),JSON 对象:
#   LARES_CIRCLE_PASSCODES={"home":"口令A","work":"口令B"}
LARES_CIRCLE_PASSCODES=

# 【建议】Web 客户端的允许来源。留空 = 回显 *(仅本地联调用)。
#   生产环境填你的前端地址,例如 https://lares.example.com
LARES_ALLOWED_ORIGIN=

# 【可选】挑战应答 nonce 有效期(毫秒),默认 60 秒
LARES_AUTH_NONCE_TTL_MS=60000


# ──────────────────────────────────────────────────────────────────────────────
# 4. 媒体端口
# ──────────────────────────────────────────────────────────────────────────────

# 【可选】LiveKit ICE/TCP 兜底端口。UDP 被墙或被 QoS 时客户端回落到这里。
#   对中国用户很重要:晚高峰 UDP 常被限速。
LARES_RTC_TCP_PORT=7881

# 【可选】LiveKit UDP mux 端口 —— **所有参与者共用这一个 UDP 端口**。
#
#   为什么只要 1 个?LiveKit 支持 UDP 多路复用,官方建议 mux 端口数 ≥ vCPU 数。
#   这台机器 1 vCPU,所以 1 个端口就是官方推荐值,也把 conntrack 压力降到最低。
#   (旧配置的 50000-60000 = 10001 个端口,对 ≤20 人语音是荒谬的浪费。)
#
#   ⚠️ 如果你改成端口段方案:LiveKit 源码里是「先判断端口段,端口段没设才用 mux」,
#      与官方文档写反了。一旦设了 port_range_*,udp_port 会被**静默忽略**。
LARES_RTC_UDP_PORT=7882

# 【可选】是否通过 STUN 自动发现公网 IP。NAT 机器必须开(默认值其实是 false)。
LARES_RTC_USE_EXTERNAL_IP=true

# 【可选】TURN。默认关闭 —— UDP mux + ICE/TCP 已能覆盖绝大多数 NAT,
#   而开 TURN 还要额外的证书和端口。确有对称 NAT 用户再开,并先跑 preflight 查冲突。
LARES_TURN_ENABLED=false
LARES_TURN_TLS_PORT=5349
LARES_TURN_UDP_PORT=3478


# ──────────────────────────────────────────────────────────────────────────────
# 5. 资源限制 —— 1GB 机器与机场共存的关键
# ──────────────────────────────────────────────────────────────────────────────
# 给每个容器设内存硬上限,这样即使 Lares 出现内存泄漏,
# 也是**它自己**被 OOM killer 干掉,而不是连累 xray。
# 总计 480MB,给系统和机场留足空间(详细预算见 README)。
LARES_MEM_LIVEKIT=256m
LARES_MEM_SERVER=128m
LARES_MEM_CADDY=96m

# 【可选】房间人数上限与 track 数上限(防异常客户端打满 1 vCPU)
LARES_MAX_PARTICIPANTS=20
LARES_LIMIT_TRACKS=100

# 【可选】LiveKit 日志级别:debug | info | warn | error
LARES_LIVEKIT_LOG_LEVEL=info
